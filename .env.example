# Copy this file to .env.local and fill in the value.
# .env.local is gitignored — it never reaches GitHub.

# YouTube Data API v3 key.
# Get one at https://console.cloud.google.com
#   1. Create a project
#   2. APIs & Services -> Library -> "YouTube Data API v3" -> Enable
#   3. APIs & Services -> Credentials -> Create credentials -> API key
#
# Leave this empty and the app still works — it just searches Audius only.
#
# NOTE: no NEXT_PUBLIC_ prefix. That prefix would ship the key to every
# visitor's browser. This one stays on the server, inside /api/search.
YOUTUBE_API_KEY=


# ---------------------------------------------------------------------
# Supabase — accounts, favorites and playlists.
# Get these at supabase.com -> your project -> Settings -> API
#
# Both of these are PUBLIC and safe in the browser. They are only safe
# because Row Level Security is enabled on every table — see
# supabase/schema.sql. A table without RLS is open to the whole internet.
#
# Never add the `service_role` key here. It ignores RLS completely and
# must never reach a browser.
#
# Leave these empty and the app still works — it just cannot save.
# ---------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
